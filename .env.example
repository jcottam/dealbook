# Reference only. Set these in the Vercel project and run `vercel env pull .env.local`.

# Comma-separated hostnames allowed for URL clip + transcribe (SSRF guard)
CLIP_ALLOWED_HOSTS=mimir-edit-web-proxies.s3.us-east-1.amazonaws.com

# Vercel Sandbox snapshot with ffmpeg preinstalled. Create with `pnpm sandbox:snapshot`.
# Without it, every request installs ffmpeg first (~30 s).
FFMPEG_SNAPSHOT_ID=

# Source uploads: private Blob store `media-utils` (OIDC). `vercel env pull` sets BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=
# Exported clips: public store `media-utils-clips-public` (`vercel blob create-store … --access public --yes`).
# BLOB_READ_WRITE_TOKEN targets that store; do not use it for private uploads.
# BLOB_READ_WRITE_TOKEN=

# Transcription via Vercel AI Gateway (dashboard → AI Gateway → API keys)
AI_GATEWAY_API_KEY=
# TRANSCRIBE_MODEL=openai/gpt-4o-transcribe

# Local Sandbox auth comes from `vercel env pull` (VERCEL_OIDC_TOKEN, ~12 h).
