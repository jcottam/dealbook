{
  "name": "media-utils",
  "version": "2.0.0",
  "private": true,
  "description": "Media Utils: tools to package and prepare content for social and production",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dealbook:sync": "node workspaces/dealbook/scripts/sync-calendar.mjs && node workspaces/dealbook/scripts/build-data.mjs",
    "dealbook:sync:dry": "node workspaces/dealbook/scripts/sync-calendar.mjs --dry-run",
    "dealbook:build:data": "node workspaces/dealbook/scripts/build-data.mjs",
    "test": "pnpm test:dealbook && pnpm test:app",
    "test:dealbook": "node --test \"workspaces/dealbook/test/*.test.mjs\"",
    "test:app": "vitest run",
    "sandbox:snapshot": "tsx --env-file=.env.local scripts/create-ffmpeg-snapshot.mts",
    "try:transcribe": "tsx --env-file=.env.local scripts/try-transcribe.mts",
    "try:clip": "tsx --env-file=.env.local scripts/try-clip.mts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.8.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.5"
}
