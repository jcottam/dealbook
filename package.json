{
  "name": "dealbook",
  "version": "2.0.0",
  "private": true,
  "description": "DealBook admin tools and hub (Next.js)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sync:calendar": "node legacy/hub/scripts/sync-calendar.mjs && node legacy/hub/scripts/build-data.mjs",
    "sync:calendar:dry": "node legacy/hub/scripts/sync-calendar.mjs --dry-run",
    "hub:legacy:start": "node legacy/hub/server/server.mjs",
    "hub:legacy:build": "node legacy/hub/scripts/build-data.mjs && node legacy/hub/scripts/build-static.mjs",
    "hub:legacy:build:data": "node legacy/hub/scripts/build-data.mjs",
    "hub:legacy:preview": "pnpm dlx serve public -l 4173",
    "test": "pnpm test:legacy && pnpm test:app",
    "test:legacy": "node --test \"legacy/hub/test/*.test.mjs\"",
    "test:app": "vitest run",
    "sandbox:snapshot": "tsx --env-file=.env.local scripts/create-ffmpeg-snapshot.mts",
    "try:transcribe": "tsx --env-file=.env.local scripts/try-transcribe.mts",
    "try:clip": "tsx --env-file=.env.local scripts/try-clip.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.8.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.5"
}
