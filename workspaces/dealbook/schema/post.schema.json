{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealbook.local/schema/post.schema.json",
  "title": "Social calendar dataset",
  "description": "Universal post model with per-platform variants. Project-specific fields live under Post.extensions.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "posts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": ["object", "null"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "campaign": {
      "type": ["object", "null"],
      "properties": {
        "throughline": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "posts": {
      "type": "array",
      "items": { "$ref": "#/$defs/Post" }
    }
  },
  "$defs": {
    "PostFormat": {
      "type": "string",
      "enum": ["carousel", "carousel-video", "video", "graphic", "other", "unspecified"]
    },
    "PostStatus": {
      "type": "string",
      "enum": ["draft", "in_review", "approved", "scheduled", "published"]
    },
    "MediaItem": {
      "type": "object",
      "required": ["kind", "ref", "order"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "video"] },
        "ref": { "type": "string", "description": "Asset id, path, or URL in your media store" },
        "order": { "type": "integer", "minimum": 0 },
        "altText": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "AspectSpecs": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "PlatformVariant": {
      "type": "object",
      "required": ["platform", "format", "status"],
      "properties": {
        "platform": {
          "type": "string",
          "description": "Normalized platform key (e.g. instagram, x, linkedin)"
        },
        "label": {
          "type": "string",
          "description": "Display name from the source calendar"
        },
        "format": { "$ref": "#/$defs/PostFormat" },
        "status": { "$ref": "#/$defs/PostStatus" },
        "caption": { "type": ["string", "null"] },
        "link": { "type": ["string", "null"] },
        "scheduledAt": { "type": ["string", "null"], "format": "date" },
        "publishedAt": { "type": ["string", "null"], "format": "date" },
        "specs": { "oneOf": [{ "$ref": "#/$defs/AspectSpecs" }, { "type": "null" }] },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/MediaItem" },
          "description": "Platform-specific media overrides; empty means inherit post.media"
        }
      },
      "additionalProperties": false
    },
    "Post": {
      "type": "object",
      "required": ["id", "title", "format", "status", "media", "platformVariants"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "format": { "$ref": "#/$defs/PostFormat" },
        "status": { "$ref": "#/$defs/PostStatus" },
        "scheduledAt": { "type": ["string", "null"], "format": "date" },
        "publishedAt": { "type": ["string", "null"], "format": "date" },
        "caption": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "link": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/MediaItem" }
        },
        "platformVariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/PlatformVariant" }
        },
        "extensions": {
          "type": "object",
          "description": "Source-system fields not part of the portable core"
        }
      },
      "additionalProperties": false
    }
  }
}
